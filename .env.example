# Server Port & Binding
PORT=3000
HOST=0.0.0.0

# Base URL that clients use to reach this Bun server (IP or DNS of the Bun host on LAN)
# e.g., http://192.168.1.50:3000
BASE_URL=http://192.168.1.50:3000

# Paths
CONFIG_PATH=./config/hosts.yaml
DATA_DIR=./data
ASSETS_DIR=./assets

# Boot Timeout in seconds before local disk boot executes
IPXE_MENU_TIMEOUT=5
